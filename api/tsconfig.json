{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "@corbitsclaw/shared": ["../packages/shared/src/index.ts"]
    }
  },
  "include": [
    "*.ts",
    "../apps/api/src/**/*.ts",
    "../packages/shared/src/**/*.ts"
  ]
}
